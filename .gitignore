# ===============================================
#  .gitignore — JavaScript Learning Repository
#  Security-first: keep secrets and deps out of git
# ===============================================

# ---------- Environment & Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets/
credentials/
config.local.*

# ---------- Dependencies ----------
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.js

# ---------- Logs & Debug ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Build / Cache ----------
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# ---------- Test / Coverage ----------
coverage/
.nyc_output/
*.lcov

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- OS ----------
$RECYCLE.BIN/
System Volume Information/

# ---------- Package manager locks ----------
# Keep package-lock.json tracked (it is a security artifact).
# Ignore stray lock files from other managers:
yarn.lock
pnpm-lock.yaml
bun.lockb

# ---------- Misc ----------
*.tmp
*.temp
*.bak
*.orig
*.rej